# Copy to .env and fill in. NEVER commit .env.

# ---- Flask backend ----
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=false

# ---- MySQL (docker-compose.yml) ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=pds
MYSQL_USER=pds
MYSQL_PASSWORD=change-me-db
MYSQL_HOST_PORT=3307
DATABASE_URL=mysql+pymysql://pds:change-me-db@127.0.0.1:3307/pds

# ---- Fabric gateway (Node.js) ----
GATEWAY_URL=http://127.0.0.1:3001
GATEWAY_PORT=3001
GATEWAY_API_KEY=change-me-at-least-16-chars
FABRIC_CHANNEL=pdschannel
FABRIC_CHAINCODE=pds

# ---- Business settings ----
DEFAULT_TOLERANCE_KG=0.2
# URL placed inside QR codes (must be reachable from the phone/PC that scans them)
PUBLIC_BASE_URL=http://localhost:5000
# Demo-only password shared by the seeded sample users (flask seed). min 10 chars, upper+lower+digit
SEED_PASSWORD=Change-Me-Demo-2026
